rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: strictly check if authenticated user is the shop administrator
    function isAdmin() {
      return request.auth != null && 
        request.auth.token.email in ['ami2s.d.lepine@gmail.com', 'contact@autodetail27.fr'];
    }

    // Products catalog: publicly readable, write restricted to authenticated admin
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Global and display settings: publicly readable, write restricted to authenticated admin
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Customer orders: customers can create orders, but ONLY admin can read/manage them (GDPR & privacy)
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
